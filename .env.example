PORT=8787
APP_BASE_URL=https://agent.example.com

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_REPOS=TritonSolutions/app-one,TritonSolutions/app-two

# TRIGGER_LABEL is the backward-compatible high-automation label; it maps to the
# full-fix action. The worker also recognizes these action labels (highest
# automation first): need-this (full-fix) > fix-review > test-it > e2e-it >
# review-it. When a PR carries several, the highest wins and is named in the
# comment. review-it and e2e-it are read-only (no commit/push).
TRIGGER_LABEL=need-this
WORKDIR=/home/ubuntu/ai-pr-worker/repos

AI_PROVIDER=claude
# AI_COMMAND must contain {{PROMPT}}. Use --model to pick the model: opus, sonnet,
# or haiku (or a pinned id like claude-opus-4-8). Parsed without a shell.
#
# Headless edits: the worker runs the CLI non-interactively with stdin closed, so
# any tool that pauses for an interactive permission prompt is blocked — the AI
# then makes no edits while the CLI still exits successfully. Pass each tool's
# approve-automatically flag. For Claude Code, --permission-mode bypassPermissions
# auto-approves edits and bash; it is safe here (unprivileged account, disposable
# checkout, protected-file commits blocked, never merges) but refuses to run as
# root outside a sandbox, so run the worker as a normal user.
AI_COMMAND=claude -p --permission-mode bypassPermissions --model opus "{{PROMPT}}"
# Other providers (use the tool's own approve-everything flag so headless edits
# are not blocked):
# AI_PROVIDER=codex
# AI_COMMAND=codex exec --full-auto --model o3 "{{PROMPT}}"
# AI_PROVIDER=aider
# AI_COMMAND=aider --yes --model sonnet --message "{{PROMPT}}"

RUN_INSTALL=false
RUN_LINT=true
RUN_TEST=true
RUN_BUILD=false
# e2e is just another configurable check. The target repo owns its database and
# spins up whatever it needs inside E2E_COMMAND; the worker never manages
# containers, migrations, or seed data.
RUN_E2E=false

INSTALL_COMMAND=npm install
LINT_COMMAND=npm run lint
TEST_COMMAND=npm test
BUILD_COMMAND=npm run build
E2E_COMMAND=npm run e2e

AUTO_PUSH=true
AUTO_MERGE=false
ALLOW_DRAFT_PRS=false
# When true, PR comments include short, masked, length-capped snippets of failed
# check output. Off by default: maskSecrets only catches known secrets, so raw
# output can still leak file contents or tokens the tools echo.
INCLUDE_RAW_OUTPUT=false

MAX_JOB_MINUTES=30
MAX_CONCURRENT_JOBS=1

NOTIFY_PROVIDER=none
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

HERMES_ENABLED=false
HERMES_COMMAND=hermes chat github-worker "{{MESSAGE}}"
