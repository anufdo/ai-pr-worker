PORT=8787
APP_BASE_URL=https://agent.example.com

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_REPOS=TritonSolutions/app-one,TritonSolutions/app-two

TRIGGER_LABEL=need-this
WORKDIR=/home/ubuntu/ai-pr-worker/repos

AI_PROVIDER=codex
AI_COMMAND=codex exec --full-auto "{{PROMPT}}"

RUN_INSTALL=false
RUN_LINT=true
RUN_TEST=true
RUN_BUILD=false

INSTALL_COMMAND=npm install
LINT_COMMAND=npm run lint
TEST_COMMAND=npm test
BUILD_COMMAND=npm run build

AUTO_PUSH=true
AUTO_MERGE=false
ALLOW_DRAFT_PRS=false

MAX_JOB_MINUTES=30
MAX_CONCURRENT_JOBS=1

NOTIFY_PROVIDER=none
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

HERMES_ENABLED=false
HERMES_COMMAND=hermes chat github-worker "{{MESSAGE}}"
